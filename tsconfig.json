{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2024"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true                    // Important: TypeScript won't emit files; Rollup does
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}